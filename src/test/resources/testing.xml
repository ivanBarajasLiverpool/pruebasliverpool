<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
   <suite name="Liverpool Commerce Unified Suite" verbose="1">
       <listeners>
           <listener class-name="com.liverpool.qa.listeners.TestListener"/>
       </listeners>

       <test name="Flujo 1 - Liverpool Web Lavadora">
           <parameter name="platform" value="web"/>
           <classes>
               <class name="com.liverpool.qa.tests.LiverpoolWebTest"/>
           </classes>
       </test>

       <test name="Flujo 2 - Banana Republic Click and Collect">
           <parameter name="platform" value="web"/>
           <classes>
               <class name="com.liverpool.qa.tests.BananaRepublicWebTest"/>
           </classes>
       </test>

       <test name="Flujo 3 - Liverpool Pocket Android">
           <parameter name="platform" value="android"/>
           <classes>
               <class name="com.liverpool.qa.tests.LiverpoolPocketTest"/>
           </classes>
       </test>
   </suite>